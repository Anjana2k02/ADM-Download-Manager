<Window x:Class="ADM.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ADM · Your downloads, organized" Width="1240" Height="820" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Grid Background="#F5F7F4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142F27">
      <Grid Margin="18,27,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,23">
          <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#B9E78D"><TextBlock Text="↓" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="ADM" FontSize="27" FontWeight="Bold" Foreground="White" Margin="10,-2,0,0" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="A little more organized." Foreground="#7D9D8C" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <StackPanel x:Name="LibraryNav">
          <TextBlock Text="YOUR LIBRARY" FontSize="9" FontWeight="Bold" Foreground="#789486" Margin="14,0,0,10"/>
          <Button x:Name="AllNav" Content="▦    All downloads" Style="{StaticResource NavButton}" Tag="All" Click="Filter_Click" Background="#2C4B3F" Foreground="White"/>
          <Button Content="↓    Downloading" Style="{StaticResource NavButton}" Tag="Active" Click="Filter_Click"/>
          <Button Content="◷    Queue &amp; scheduled" Style="{StaticResource NavButton}" Tag="Queue" Click="Filter_Click"/>
          <Button Content="Ⅱ    Paused" Style="{StaticResource NavButton}" Tag="Paused" Click="Filter_Click"/>
          <Button Content="✓    Completed" Style="{StaticResource NavButton}" Tag="Completed" Click="Filter_Click"/>
          <Button Content="!     Needs attention" Style="{StaticResource NavButton}" Tag="Failed" Click="Filter_Click"/>
        </StackPanel>
        <StackPanel x:Name="CategoryNav" Margin="0,16,0,0">
          <TextBlock Text="FILE CATEGORIES" FontSize="9" FontWeight="Bold" Foreground="#789486" Margin="14,0,0,10"/>
          <Button Content="▤    Documents" Style="{StaticResource NavButton}" Tag="Documents" Click="Filter_Click" Padding="14,8"/>
          <Button Content="▷    Video" Style="{StaticResource NavButton}" Tag="Video" Click="Filter_Click" Padding="14,8"/>
          <Button Content="♫    Music" Style="{StaticResource NavButton}" Tag="Music" Click="Filter_Click" Padding="14,8"/>
          <Button Content="⊞    Programs" Style="{StaticResource NavButton}" Tag="Programs" Click="Filter_Click" Padding="14,8"/>
          <Button Content="▣    Archives" Style="{StaticResource NavButton}" Tag="Archives" Click="Filter_Click" Padding="14,8"/>
          <Button Content="◇    Images" Style="{StaticResource NavButton}" Tag="Images" Click="Filter_Click" Padding="14,8"/>
          <Button Content="···    Other" Style="{StaticResource NavButton}" Tag="Other" Click="Filter_Click" Padding="14,8"/>
        </StackPanel>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="4">
          <Button Content="⚙    Preferences" Style="{StaticResource NavButton}" Click="Settings_Click"/>
          <Border Height="1" Background="#2C463A" Margin="10,13"/>
          <TextBlock x:Name="VersionLabel" Text="ADM  /  MADE FOR WINDOWS" Foreground="#789486" FontSize="9" Margin="14,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <StackPanel><TextBlock Text="YOUR PERSONAL DOWNLOAD MANAGER" Foreground="#7B8981" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="All downloads" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock Text="Everything you need. Right where it belongs." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Paste link" Click="Paste_Click" Margin="0,0,8,0" ToolTip="Add a URL from your clipboard (Ctrl+V)"/><Button Content="＋  New download" Style="{StaticResource PrimaryButton}" Click="Add_Click" Padding="17,11" ToolTip="Add a download (Ctrl+N)"/></StackPanel>
      </Grid>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><Grid><StackPanel><TextBlock Text="TRANSFER SPEED" FontSize="9" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="SpeedStat" Text="0 B/s" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="ConnectionStat" Text="Ready when you are" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><Polyline x:Name="SpeedGraph" Stroke="#47A47E" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="72" Height="32" Stretch="Fill" Opacity="0.7" Points="0,30 12,30 24,30 36,30 48,30 60,30 72,30"/></Grid></Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="IN PROGRESS" FontSize="9" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="ActiveStat" Text="0 downloads" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="QueueStat" Text="Your queue is clear" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DOWNLOADED" FontSize="9" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="TotalStat" Text="0 B" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="CompletedStat" Text="0 completed files" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2" Margin="0,0,0,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" MaxWidth="285" HorizontalAlignment="Left" Width="260" ToolTip="Search downloads by name, URL, or category" AutomationProperties.Name="Search downloads"/>
        <TextBlock x:Name="SearchHint" Text="⌕   Search your downloads" IsHitTestVisible="False" Foreground="#8D9992" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ResumeButton" Content="▷  Resume" Click="Resume_Click" Margin="0,0,6,0" IsEnabled="False"/><Button x:Name="PauseButton" Content="Ⅱ  Pause" Click="Pause_Click" Margin="0,0,6,0" IsEnabled="False"/><Button Content="Pause all" Click="PauseAll_Click" Margin="0,0,6,0"/><Button x:Name="MoreButton" Content="···" Click="More_Click" Padding="12,6" ToolTip="More actions"><Button.ContextMenu><ContextMenu><MenuItem Header="Open file" Click="OpenFile_Click"/><MenuItem Header="Show in folder" Click="OpenFolder_Click"/><MenuItem Header="Copy download URL" Click="CopyUrl_Click"/><MenuItem Header="Copy SHA-256" Click="CopyHash_Click"/><Separator/><MenuItem Header="Set speed limit…" Click="ItemSpeed_Click"/><MenuItem Header="Restart from beginning…" Click="Restart_Click"/><MenuItem Header="Remove from list…" Click="Remove_Click"/><Separator/><MenuItem Header="Clear completed history" Click="ClearCompleted_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Background="White" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="DownloadsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2EE" BorderThickness="0" Background="White" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Selection_Changed" MouseDoubleClick="Grid_DoubleClick" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="FILE NAME" Width="*" MinWidth="190" SortMemberPath="FileName"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{Binding IconBackground}" Width="33" Height="38" CornerRadius="6" HorizontalAlignment="Left"><TextBlock Text="{Binding Extension}" FontSize="8" FontWeight="Bold" Foreground="{Binding IconForeground}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding Subtitle}" Foreground="#89958E" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="85" SortMemberPath="TotalBytes"/>
              <DataGridTemplateColumn Header="STATUS / PROGRESS" Width="170" SortMemberPath="StatusText"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><DockPanel Margin="0,0,0,7"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="#89958E" FontSize="10"/></DockPanel><ProgressBar Height="3" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Foreground="{Binding StatusColor}" Background="#EAF0EB" BorderThickness="0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="SPEED" Binding="{Binding SpeedText}" Width="95"/>
              <DataGridTextColumn Header="TIME LEFT" Binding="{Binding EtaText}" Width="84"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,30,20,0">
            <Border Background="#EDF5E9" CornerRadius="18" Width="64" Height="64" HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="40" Foreground="#44845D" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/></Border>
            <TextBlock x:Name="EmptyTitle" Text="A fresh start for your downloads" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,7"/>
            <TextBlock x:Name="EmptySubtitle" Text="Add a link. ADM will take care of the organization." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
            <Button x:Name="EmptyAdd" Content="＋  Add your first download" Style="{StaticResource PrimaryButton}" Click="Add_Click" HorizontalAlignment="Center" Margin="0,20,0,15"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="DetailHeading" Text="A place for every file" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="DetailText" Text="Automatic categories keep your download folder tidy." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,18,0" TextWrapping="Wrap" MaxHeight="44"/><TextBlock x:Name="DetailPath" Text="" Foreground="#89958E" FontSize="10" Margin="0,7,18,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
          <Button Grid.Column="1" x:Name="FolderButton" Content="Open folder  ↗" VerticalAlignment="Center" Click="OpenFolder_Click"/>
        </Grid>
      </Border>
      <Grid Grid.Row="5" Margin="1,14,1,0"><TextBlock x:Name="StatusBar" Text="●  Ready" Foreground="#6A7B70" FontSize="10"/><TextBlock x:Name="LimitStatus" Text="No speed limit  ·  Auto categories on" Foreground="#7E8C83" FontSize="10" HorizontalAlignment="Right"/></Grid>
    </Grid>
  </Grid>
</Window>
